<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/premium_header"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_launcher_foreground" />

            <TextView
                android:id="@+id/appTitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/meeting_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/meetingStateText"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/status_chip_neutral"
                android:gravity="center"
                android:minWidth="88dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/state_ready"
                android:textColor="@color/meeting_primary_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/uiLanguageSpinner"
                android:layout_width="56dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/premium_input_panel"
                android:contentDescription="@string/app_name" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:text="@string/status_ready"
            android:textColor="@color/meeting_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/meetingSummaryLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/readinessSummaryText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/status_chip_neutral"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:text="@string/readiness_checking"
                android:textColor="@color/meeting_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modelModeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/status_chip_neutral"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:text="@string/mode_offline_first"
                android:textColor="@color/meeting_text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/rootScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:id="@+id/commandCenterDeck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/command_center_panel"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/commandCenterTitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/command_center_title"
                    android:textColor="@color/meeting_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/commandCenterSubtitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/command_center_subtitle"
                    android:textColor="@color/meeting_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/commandStepRail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/stepLanguageText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/status_chip_neutral"
                        android:gravity="center"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:text="@string/step_language"
                        android:textColor="@color/meeting_primary_dark"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/stepReadinessText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/status_chip_warning"
                        android:gravity="center"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:text="@string/step_readiness"
                        android:textColor="@color/meeting_gold"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/stepCaptureText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/status_chip_neutral"
                        android:gravity="center"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:text="@string/step_capture"
                        android:textColor="@color/meeting_primary_dark"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/premium_input_panel"
                        android:orientation="vertical">

                        <Spinner
                            android:id="@+id/languageOneSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="44dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/swapLanguagesButton"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/primary_button"
                        android:text="@string/swap_languages"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/premium_input_panel"
                        android:orientation="vertical">

                        <Spinner
                            android:id="@+id/languageTwoSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="44dp" />
                    </LinearLayout>
                </LinearLayout>

                <Switch
                    android:id="@+id/autoDetectLanguageSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/premium_input_panel"
                    android:checked="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/auto_detect_language"
                    android:textColor="@color/meeting_text"
                    android:textSize="15sp"
                    tools:ignore="UseSwitchCompatOrMaterialXml" />

                <LinearLayout
                    android:id="@+id/readinessPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/premium_input_panel"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/readinessTitleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/readiness_title"
                        android:textColor="@color/meeting_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sttReadinessText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/readiness_checking"
                        android:textColor="@color/meeting_muted"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/translationReadinessText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/readiness_checking"
                        android:textColor="@color/meeting_muted"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/ttsReadinessText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/readiness_checking"
                        android:textColor="@color/meeting_muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/manageModelsButton"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/primary_button"
                    android:text="@string/manage_models"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/modelPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <Spinner
                        android:id="@+id/sttModelSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="44dp" />

                    <TextView
                        android:id="@+id/modelHelpText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <Spinner
                        android:id="@+id/translationModelSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="44dp" />

                    <Spinner
                        android:id="@+id/ttsVoiceSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="44dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/listenButton"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/primary_button"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/start_listening"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/openFileButton"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/secondary_button"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/open_file"
                        android:textAllCaps="false"
                        android:textColor="@color/meeting_primary_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/capturePhotoButton"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/secondary_button"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/capture_photo"
                        android:textAllCaps="false"
                        android:textColor="@color/meeting_primary_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/panel_background"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/manualTranscriptLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enter_transcript"
                    android:textColor="@color/meeting_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/manualTranscriptInput"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/premium_input_panel"
                    android:gravity="top"
                    android:hint="@string/manual_transcript_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="3"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/meeting_text"
                    android:textColorHint="@color/meeting_muted"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/getTranscriptButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/primary_button"
                        android:ellipsize="end"
                        android:maxLines="1"
                        style="?android:attr/buttonBarButtonStyle"
                        android:text="@string/get_transcript"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/translateManualButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/primary_button"
                        android:ellipsize="end"
                        android:maxLines="1"
                        style="?android:attr/buttonBarButtonStyle"
                        android:text="@string/translate_transcript"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/source_result_panel"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/sourceLanguageText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/source_empty"
                    android:textColor="@color/meeting_primary_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sourceText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="84dp"
                    android:text="@string/source_placeholder"
                    android:textColor="@color/meeting_text"
                    android:textSize="19sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/speakSourceButton"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/primary_button"
                        android:enabled="false"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/speak_source"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/shareSourceButton"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/secondary_button"
                        android:enabled="false"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/share"
                        android:textAllCaps="false"
                        android:textColor="@color/meeting_primary_dark"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/target_result_panel"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/targetLanguageText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/target_empty"
                    android:textColor="@color/meeting_primary_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/targetText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="96dp"
                    android:text="@string/target_placeholder"
                    android:textColor="@color/meeting_text"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/speakTargetButton"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/primary_button"
                        android:enabled="false"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/speak_target"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/shareTargetButton"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/secondary_button"
                        android:enabled="false"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/share"
                        android:textAllCaps="false"
                        android:textColor="@color/meeting_primary_dark"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/timelinePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/panel_background"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/timelineTitleText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/timeline_title"
                        android:textColor="@color/meeting_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/exportSessionButton"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/secondary_button"
                        android:enabled="false"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/export_session"
                        android:textAllCaps="false"
                        android:textColor="@color/meeting_primary_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/resetSessionButton"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/destructive_button"
                        android:enabled="false"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/reset_session"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/stopSpeechButton"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/secondary_button"
                        android:enabled="false"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/stop_speech"
                        android:textAllCaps="false"
                        android:textColor="@color/meeting_primary_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/timelineEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/timeline_empty"
                    android:textColor="@color/meeting_muted"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/timelineListLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNavLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/premium_header"
        android:elevation="10dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/meetingHeaderButton"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/primary_button"
            android:contentDescription="@string/app_name"
            android:padding="10dp"
            android:scaleType="center"
            android:src="@drawable/ic_nav_meeting"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/assistantHeaderButton"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="5dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/secondary_button"
            android:contentDescription="@string/header_assistant"
            android:padding="10dp"
